{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calm.finos.org/extensions/aws/aws.standard.json",
  "title": "CALM AWS Extension Standard",
  "description": "CALM 1.2 overlay Standard for the AWS pack. Extends node-type with the pack's type ids. Architecture shape remains https://calm.finos.org/release/1.2/meta/calm.json. Hosts write this $id into architecture $schema when the pack is first used, even before the URI is published on calm.finos.org.",
  "$comment": "Proposed until published under calm.finos.org. Load from extensions/standards/ on the filesystem.",
  "$defs": {
    "node-type": {
      "type": "string",
      "enum": [
        "aws:lambda",
        "aws:ec2",
        "aws:ecs",
        "aws:eks",
        "aws:fargate",
        "aws:s3",
        "aws:efs",
        "aws:dynamodb",
        "aws:rds",
        "aws:aurora",
        "aws:elasticache",
        "aws:redshift",
        "aws:vpc",
        "aws:subnet",
        "aws:internet-gateway",
        "aws:nat-gateway",
        "aws:route-table",
        "aws:cloudfront",
        "aws:route53",
        "aws:elb",
        "aws:api-gateway",
        "aws:iam",
        "aws:cognito",
        "aws:waf",
        "aws:kms",
        "aws:secrets-manager",
        "aws:sqs",
        "aws:sns",
        "aws:eventbridge",
        "aws:step-functions",
        "aws:kinesis",
        "aws:glue",
        "aws:sagemaker",
        "aws:cloudwatch"
      ],
      "description": "AWS node-type values."
    }
  }
}
