            "description": "A user opens an extension screen. Hub proxies the screen route and renders the returned blocks",
            "transitions": [
                {
                    "relationship-unique-id": "user-interacts-with-ui",
                    "sequence-number": 1,
                    "description": "User opens an extension screen from the menu"
                },
                {
                    "relationship-unique-id": "hub-ui-to-hub",
