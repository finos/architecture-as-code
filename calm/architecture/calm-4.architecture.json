                    "description": "The UI requests the screen route through the extension proxy"
                },
                {
                    "relationship-unique-id": "hub-to-extension",
                    "sequence-number": 3,
                    "description": "Hub checks the route scope and calls the backend with a signed assertion"
                },
                {
                    "relationship-unique-id": "extension-to-hub-jwks",
                    "sequence-number": 4,
                    "description": "The extension verifies the assertion against Hub's JWKS"
                },
