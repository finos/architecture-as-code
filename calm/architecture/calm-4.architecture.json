                    "relationship-unique-id": "hub-ui-to-hub",
                    "sequence-number": 6,
                    "description": "The UI renders the blocks with Hub components",
                    "direction": "destination-to-source"
                }
            ]
        },
        {
            "unique-id": "flow-extension-command",
            "name": "Call an extension command",
            "description": "A script or agent calls a manifest command through the CLI or MCP",
            "transitions": [
                {
                    "relationship-unique-id": "agent-interacts-with-cli",
                    "sequence-number": 1,
                    "description": "A script runs 'calm hub ext <id> <command> --input'"
                },
                {
                    "relationship-unique-id": "cli-to-hub",
                    "sequence-number": 2,
                    "description": "The CLI sends the input. Hub validates it against the command schema"
                },
                {
                    "relationship-unique-id": "agent-to-hub-mcp",
                    "sequence-number": 3,
                    "description": "Or: an AI agent calls the command's MCP tool"
                },
                {
                    "relationship-unique-id": "hub-to-extension",
                    "sequence-number": 4,
                    "description": "Hub forwards the route with a signed assertion"
                },
                {
                    "relationship-unique-id": "hub-to-extension",
                    "sequence-number": 5,
                    "description": "The command result returns as JSON",
                    "direction": "destination-to-source"
                }
            ]
        },
        {
            "unique-id": "flow-post-write-event",
            "name": "Deliver a post-write event",
            "description": "Hub validates a published architecture and tells subscribers about the write",
            "transitions": [
                {
                    "relationship-unique-id": "cli-to-hub",
                    "sequence-number": 1,
                    "description": "User publishes a new architecture version"
                },
                {
                    "relationship-unique-id": "hub-to-db",
                    "sequence-number": 2,
                    "description": "Hub writes the version and its pending event in one insert"
                },
                {
                    "relationship-unique-id": "hub-to-calm-server",
                    "sequence-number": 3,
                    "description": "Hub validates the version against its Pattern and bound standards-only Patterns"
                },
                {
                    "relationship-unique-id": "hub-to-event-subscriber",
                    "sequence-number": 4,
                    "description": "Hub delivers a signed, thin event"
                },
                {
                    "relationship-unique-id": "subscriber-to-hub-api",
                    "sequence-number": 5,
                    "description": "The subscriber reads the version with its own service account"
                }
            ]
        }
