<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.architecture-as-code</groupId><artifactId>parent</artifactId>
        <version>1.0.0</version><relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>calm-intellij</artifactId>
    <version>0.4.1</version>
    <name>CALM IntelliJ Plugin</name>
    <properties>
        <intellij.build>262.9437.185</intellij.build>
        <intellij.since.build>262.9437.185</intellij.since.build>
        <kotlin.version>2.4.0</kotlin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <npm.executable>npm</npm.executable>
        <webview.skip>false</webview.skip>
    </properties>
    <repositories>
        <repository><id>intellij-releases</id><url>https://www.jetbrains.com/intellij-repository/releases</url></repository>
        <repository><id>intellij-dependencies</id><url>https://cache-redirector.jetbrains.com/intellij-dependencies</url></repository>
    </repositories>
    <dependencies>
        <!-- SDK APIs are supplied by the IDE and must not be bundled into the plugin. -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>ide</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>ide-core</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>core</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>core-ui</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>editor-ui</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>project-model</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>analysis</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>util</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>util-base</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>util-ui</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>util-progress</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>extensions</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId><artifactId>ui-jcef</artifactId>
            <version>${intellij.build}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.intellij.deps.jcef</groupId><artifactId>jcef</artifactId>
            <version>144.0.15-g72717cf-chromium-144.0.7559.172-api-1.21-262-b37</version><scope>provided</scope>
        </dependency>
        <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>26.0.2</version><scope>provided</scope></dependency>
        <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.13.2</version><scope>provided</scope></dependency>
        <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <resources>
            <resource><directory>src/main/resources</directory><excludes><exclude>META-INF/plugin.xml</exclude></excludes></resource>
            <resource><directory>src/main/resources</directory><filtering>true</filtering><includes><include>META-INF/plugin.xml</include></includes></resource>
            <resource><directory>webview/dist</directory><targetPath>webview</targetPath></resource>
            <resource><directory>webview/vendor/preview-0.6</directory><targetPath>META-INF/calm-upstream</targetPath><includes><include>LICENSE</include><include>NOTICE</include><include>UPSTREAM.md</include></includes></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.6.2</version>
                <executions><execution><id>java-runtime</id><goals><goal>enforce</goal></goals><configuration><rules><requireJavaVersion><version>[25,)</version></requireJavaVersion></rules></configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version>
                <executions><execution><id>build-webview</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
                    <configuration><skip>${webview.skip}</skip><executable>${npm.executable}</executable><workingDirectory>${project.basedir}/../..</workingDirectory>
                        <arguments><argument>run</argument><argument>build:intellij</argument></arguments>
                    </configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId><version>${kotlin.version}</version>
                <configuration><jvmTarget>25</jvmTarget><args><arg>-jvm-default=no-compatibility</arg></args></configuration>
                <executions>
                    <execution><id>compile</id><phase>compile</phase><goals><goal>compile</goal></goals></execution>
                    <execution><id>test-compile</id><phase>test-compile</phase><goals><goal>test-compile</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version>
                <configuration><useDefaultDelimiters>false</useDefaultDelimiters><delimiters><delimiter>@</delimiter></delimiters></configuration>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.5</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-assembly-plugin</artifactId><version>3.8.0</version>
                <configuration><descriptors><descriptor>src/assembly/plugin.xml</descriptor></descriptors></configuration>
                <executions><execution><id>plugin-zip</id><phase>package</phase><goals><goal>single</goal></goals></execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
