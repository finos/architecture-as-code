{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "actor-customer",
      "node-type": "actor",
      "name": "Customer",
      "description": "External user placing and tracking orders"
    },
    {
      "unique-id": "service-order",
      "node-type": "service",
      "name": "Order Service",
      "description": "REST API that processes customer orders and persists state",
      "interfaces": [
        {
          "unique-id": "order-http-interface",
          "protocol": "HTTPS",
          "port": 8443
        }
      ],
      "controls": {
        "api-gateway": {
          "description": "Public microservices must be fronted by an API gateway for routing, rate limiting, and token validation",
          "requirements": [
            {
              "requirement-url": "https://example.com/controls/api-gateway.requirement.json",
              "config": {
                "value": "Kong"
              }
            }
          ],
          "metadata": {
            "validation": {
              "allowed-values": [
                "Kong",
                "Envoy",
                "AWS API GW",
                "Azure API GW"
              ]
            }
          }
        },
        "api-security": {
          "description": "Service must implement API authentication and authorization",
          "requirements": [
            {
              "requirement-url": "https://example.com/controls/api-security.requirement.json",
              "config": {
                "value": "OAuth2"
              }
            }
          ],
          "metadata": {
            "validation": {
              "allowed-values": [
                "OAuth2",
                "mTLS"
              ]
            }
          }
        },
        "health-api": {
          "description": "Service must expose a health check endpoint for liveness and readiness probes",
          "requirements": [
            {
              "requirement-url": "https://example.com/controls/health-api.requirement.json",
              "config": {
                "value": "/health"
              }
            }
          ],
          "metadata": {
            "validation": {
              "pattern": "^/[a-z][a-z0-9/-]*$",
              "example": "/actuator/health"
            }
          }
        },
        "observability": {
          "description": "Microservices must emit distributed traces, structured logs, and metrics",
          "requirements": [
            {
              "requirement-url": "https://example.com/controls/observability.requirement.json",
              "config": {
                "value": "OpenTelemetry"
              }
            }
          ],
          "metadata": {
            "validation": {
              "allowed-values": [
                "OpenTelemetry"
              ]
            }
          }
        }
      }
    },
    {
      "unique-id": "database-orders",
      "node-type": "database",
      "name": "Orders Database",
      "description": "Relational datastore storing order records",
      "interfaces": [
        {
          "unique-id": "orders-jdbc-interface",
          "protocol": "JDBC",
          "port": 5432
        }
      ]
    }
  ],
  "relationships": [
    {
      "unique-id": "rel-customer-to-order-service",
      "description": "Customer submits orders over HTTPS",
      "protocol": "HTTPS",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "actor-customer"
          },
          "destination": {
            "node": "service-order",
            "interfaces": [
              "order-http-interface"
            ]
          }
        }
      }
    },
    {
      "unique-id": "rel-order-service-to-db",
      "description": "Order Service reads and writes order records",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "service-order"
          },
          "destination": {
            "node": "database-orders",
            "interfaces": [
              "orders-jdbc-interface"
            ]
          }
        }
      }
    }
  ],
  "metadata": {
    "_layout": {
      "actor-customer": {
        "x": 438,
        "y": -89,
        "w": 44,
        "h": 63
      },
      "service-order": {
        "x": 386,
        "y": 67,
        "w": 149,
        "h": 33
      },
      "database-orders": {
        "x": 431,
        "y": 205,
        "w": 56,
        "h": 63
      }
    }
  }
}
