{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calm.finos.org/calm-hub/extensions/hub-api-0/blocks.schema.json",
  "type": "object",
  "properties": {
    "hubApi": {
      "const": 0
    },
    "title": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "markdown"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "keyValue"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "stats"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "filter": {
                      "$ref": "#/$defs/statFilter"
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "table"
              },
              "id": {
                "description": "Names the table, so that a stat filter can select it. Unique in the reply. Required with search or source. CALM Hub keeps the filters of the table in the screen URL as <id>.filter, <id>.q and <id>.page.",
                "$ref": "#/$defs/tableId"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/cell"
                  }
                }
              },
              "search": {
                "description": "Shows a text filter for the rows. It combines with the stat filter: a row must match both.",
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "columns": {
                    "description": "The columns that the text filter searches. Default: all columns.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "source": {
                "description": "Loads the rows one page at a time from a GET route with readOnly, which filters the whole dataset. CALM Hub sends the context and filter, q, page and pageSize in the query; the route replies with $defs/tableRowsReply. Without a source, rows are the whole dataset and CALM Hub filters them in the browser. A CALM Hub that does not read source shows rows.",
                "type": "object",
                "properties": {
                  "route": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "pageSize": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 20
                  }
                },
                "required": [
                  "route"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "columns",
              "rows"
            ],
            "dependentRequired": {
              "search": [
                "id"
              ],
              "source": [
                "id"
              ]
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "cards"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "link": {
                      "$ref": "#/$defs/link"
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "alert"
              },
              "tone": {
                "enum": [
                  "positive",
                  "negative",
                  "warning",
                  "info",
                  "neutral"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "links"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/link"
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "hubApi",
    "blocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "resource": {
      "description": "One version of a Hub resource, and optionally an element in it.",
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/segment"
        },
        "type": {
          "$ref": "#/$defs/segment"
        },
        "id": {
          "$ref": "#/$defs/segment"
        },
        "version": {
          "$ref": "#/$defs/segment"
        },
        "element": {
          "description": "The CALM unique-id of a node or relationship in that version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "namespace",
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "hub": {
      "description": "A Hub resource page. extension opens the contextual view of that extension with the resource.",
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/segment"
        },
        "type": {
          "$ref": "#/$defs/segment"
        },
        "id": {
          "$ref": "#/$defs/segment"
        },
        "version": {
          "$ref": "#/$defs/segment"
        },
        "element": {
          "description": "The CALM unique-id of a node or relationship in that version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "extension": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "namespace",
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "screen": {
      "description": "A top-level extension screen, optionally for a resource, with view parameters: screen params (no dot) and table keys. maxProperties bounds only the total. Hub checks in code that there are at most 8 screen params and 12 table keys, and that the resource context and screen params take at most 2048 characters form-encoded.",
      "type": "object",
      "properties": {
        "extension": {
          "$ref": "#/$defs/id"
        },
        "screen": {
          "$ref": "#/$defs/id"
        },
        "context": {
          "$ref": "#/$defs/resource"
        },
        "params": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "not": {
              "enum": [
                "namespace",
                "resource",
                "resourceType",
                "resourceId",
                "version",
                "selectedElement"
              ]
            }
          },
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "type": "string",
              "maxLength": 256
            },
            "^[a-z][a-z0-9-]{0,63}\\.filter$": {
              "type": "string",
              "maxLength": 100
            },
            "^[a-z][a-z0-9-]{0,63}\\.q$": {
              "type": "string",
              "maxLength": 200
            },
            "^[a-z][a-z0-9-]{0,63}\\.page$": {
              "type": "string",
              "pattern": "^(?:[2-9]|[1-9][0-9]{1,3}|10000)$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "extension",
        "screen"
      ],
      "additionalProperties": false
    },
    "destination": {
      "description": "Where a link goes: exactly one of an external href, a Hub resource page or an extension screen. Search results and chat citations use it too.",
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "hub": {
          "$ref": "#/$defs/hub"
        },
        "screen": {
          "$ref": "#/$defs/screen"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "href"
          ]
        },
        {
          "required": [
            "hub"
          ]
        },
        {
          "required": [
            "screen"
          ]
        }
      ]
    },
    "link": {
      "description": "A destination with a label.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "hub": {
          "$ref": "#/$defs/hub"
        },
        "screen": {
          "$ref": "#/$defs/screen"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "href"
          ]
        },
        {
          "required": [
            "hub"
          ]
        },
        {
          "required": [
            "screen"
          ]
        }
      ]
    },
    "cell": {
      "oneOf": [
        {
          "type": [
            "string",
            "number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "badge": {
              "type": "string"
            },
            "tone": {
              "enum": [
                "positive",
                "negative",
                "warning",
                "info",
                "neutral"
              ]
            }
          },
          "required": [
            "badge"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/link"
        }
      ]
    },
    "tableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "statFilter": {
      "description": "Makes the tile a button that filters the table with this id in the same reply. A tile without id shows all rows. For a table with rows, column and value select the rows whose cell in column shows value. For a table with a source, CALM Hub sends id as the filter query parameter. The tile value stays the figure of the extension.",
      "type": "object",
      "properties": {
        "table": {
          "$ref": "#/$defs/tableId"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "column": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "table"
      ],
      "dependentRequired": {
        "column": [
          "id",
          "value"
        ],
        "value": [
          "column"
        ]
      },
      "additionalProperties": false
    },
    "tableRowsReply": {
      "description": "The reply of a table source route: one page of rows, and total, the number of rows that match the filters.",
      "type": "object",
      "properties": {
        "hubApi": {
          "const": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "hubApi",
        "rows",
        "total"
      ],
      "additionalProperties": false
    }
  }
}
