{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calm.finos.org/calm-hub/extensions/hub-api-0/blocks.schema.json",
  "type": "object",
  "properties": {
    "hubApi": {
      "const": 0
    },
    "title": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "markdown"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "keyValue"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "stats"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "table"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/cell"
                  }
                }
              }
            },
            "required": [
              "type",
              "columns",
              "rows"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "cards"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "link": {
                      "$ref": "#/$defs/link"
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "alert"
              },
              "tone": {
                "enum": [
                  "positive",
                  "negative",
                  "warning",
                  "info",
                  "neutral"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "links"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/link"
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "hubApi",
    "blocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "resource": {
      "description": "One version of a Hub resource, and optionally an element in it.",
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/segment"
        },
        "type": {
          "$ref": "#/$defs/segment"
        },
        "id": {
          "$ref": "#/$defs/segment"
        },
        "version": {
          "$ref": "#/$defs/segment"
        },
        "element": {
          "description": "The CALM unique-id of a node or relationship in that version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "namespace",
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "hub": {
      "description": "A Hub resource page. extension opens the contextual view of that extension with the resource.",
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/segment"
        },
        "type": {
          "$ref": "#/$defs/segment"
        },
        "id": {
          "$ref": "#/$defs/segment"
        },
        "version": {
          "$ref": "#/$defs/segment"
        },
        "element": {
          "description": "The CALM unique-id of a node or relationship in that version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "extension": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "namespace",
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "screen": {
      "description": "A top-level extension screen, optionally for a resource, with view parameters: screen params (no dot) and table keys. maxProperties bounds only the total. Hub checks in code that there are at most 8 screen params and 12 table keys, and that the resource context and screen params take at most 2048 characters form-encoded.",
      "type": "object",
      "properties": {
        "extension": {
          "$ref": "#/$defs/id"
        },
        "screen": {
          "$ref": "#/$defs/id"
        },
        "context": {
          "$ref": "#/$defs/resource"
        },
        "params": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "not": {
              "enum": [
                "namespace",
                "resource",
                "resourceType",
                "resourceId",
                "version",
                "selectedElement"
              ]
            }
          },
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "type": "string",
              "maxLength": 256
            },
            "^[a-z][a-z0-9-]{0,63}\\.filter$": {
              "type": "string",
              "maxLength": 100
            },
            "^[a-z][a-z0-9-]{0,63}\\.q$": {
              "type": "string",
              "maxLength": 200
            },
            "^[a-z][a-z0-9-]{0,63}\\.page$": {
              "type": "string",
              "pattern": "^(?:[2-9]|[1-9][0-9]{1,3}|10000)$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "extension",
        "screen"
      ],
      "additionalProperties": false
    },
    "destination": {
      "description": "Where a link goes: exactly one of an external href, a Hub resource page or an extension screen. Search results and chat citations use it too.",
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "hub": {
          "$ref": "#/$defs/hub"
        },
        "screen": {
          "$ref": "#/$defs/screen"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "href"
          ]
        },
        {
          "required": [
            "hub"
          ]
        },
        {
          "required": [
            "screen"
          ]
        }
      ]
    },
    "link": {
      "description": "A destination with a label.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "hub": {
          "$ref": "#/$defs/hub"
        },
        "screen": {
          "$ref": "#/$defs/screen"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "href"
          ]
        },
        {
          "required": [
            "hub"
          ]
        },
        {
          "required": [
            "screen"
          ]
        }
      ]
    },
    "cell": {
      "oneOf": [
        {
          "type": [
            "string",
            "number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "badge": {
              "type": "string"
            },
            "tone": {
              "enum": [
                "positive",
                "negative",
                "warning",
                "info",
                "neutral"
              ]
            }
          },
          "required": [
            "badge"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/link"
        }
      ]
    }
  }
}
