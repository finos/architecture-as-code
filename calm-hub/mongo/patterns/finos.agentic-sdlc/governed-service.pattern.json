{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://hub.calm.finos.org/calm/namespaces/finos.agentic-sdlc/patterns/governed-service/versions/1.0.0",
  "title": "Governed service pattern",
  "description": "How this estate enforces the SDLC Common Controls on every architecture. The pattern requires the four system-level controls, pins each to its control requirement document in the finos-sdlc-common-controls domain on CALM Hub, and defines the parameters the gates read. Every node satisfies the governed-node Standard, which carries the metadata the gates read and the environment binding on every interface; a node that carries Service Dependency Control declares its allowed sources.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://hub.calm.finos.org/calm/namespaces/finos.agentic-sdlc/standards/governed-node/versions/1.0.0"
          },
          {
            "type": "object",
            "properties": {
              "controls": {
                "type": "object",
                "properties": {
                  "sdlc-prev-017-service-dependency": {
                    "$ref": "#/$defs/service-dependency-control"
                  }
                },
                "patternProperties": {
                  ".*": {
                    "if": {
                      "type": "object",
                      "properties": {
                        "requirements": {
                          "type": "array",
                          "contains": {
                            "type": "object",
                            "properties": {
                              "requirement-url": {
                                "const": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-017-service-dependency-control/requirement/versions/1.0.0"
                              }
                            },
                            "required": [
                              "requirement-url"
                            ]
                          }
                        }
                      },
                      "required": [
                        "requirements"
                      ]
                    },
                    "then": {
                      "$ref": "#/$defs/service-dependency-control"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/relationship"
      },
      "description": "Each relationship must be valid CALM; which nodes connect is unconstrained here. What a service may connect to is stated by the relationships themselves and by node-level controls, and checked against the code by gates/drift-check.mjs."
    },
    "controls": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/control.json#/defs/controls"
        }
      ],
      "properties": {
        "sdlc-prev-001-code-review": {
          "$ref": "#/$defs/code-review"
        },
        "sdlc-prev-004-requirements-repository": {
          "$ref": "#/$defs/requirements-repository"
        },
        "sdlc-prev-012-deployment-gating": {
          "$ref": "#/$defs/deployment-gating"
        },
        "sdlc-prev-014-test-evidence-retention": {
          "$ref": "#/$defs/test-evidence-retention"
        }
      },
      "required": [
        "sdlc-prev-001-code-review",
        "sdlc-prev-004-requirements-repository",
        "sdlc-prev-012-deployment-gating",
        "sdlc-prev-014-test-evidence-retention"
      ]
    }
  },
  "required": [
    "nodes",
    "relationships",
    "controls"
  ],
  "$defs": {
    "code-review": {
      "description": "SDLC-PREV-001 Code Review, as enforced here: a deterministic review routing policy that gates/review-router.mjs applies.",
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "requirement-url": {
                  "const": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-001-code-review/requirement/versions/1.0.0",
                  "description": "The catalog's control requirement document on CALM Hub; the CLI validates the config against it"
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "author-may-not-review": {
                      "const": true,
                      "description": "The author of a change never satisfies its review requirement"
                    },
                    "default-mode": {
                      "enum": [
                        "human",
                        "cognitive",
                        "automated"
                      ],
                      "description": "Review mode when no rule matches: fail safe"
                    },
                    "rules": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Evaluated in order by gates/review-router.mjs; the first match decides the mode",
                      "items": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "enum": [
                              "human",
                              "cognitive",
                              "automated"
                            ]
                          },
                          "reason": {
                            "type": "string"
                          },
                          "paths": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "max-criticality-tier": {
                            "type": "integer"
                          },
                          "data-classifications": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "mode",
                          "reason"
                        ]
                      }
                    }
                  },
                  "required": [
                    "author-may-not-review",
                    "default-mode",
                    "rules"
                  ]
                }
              },
              "required": [
                "requirement-url",
                "config"
              ]
            }
          ]
        }
      },
      "required": [
        "requirements"
      ]
    },
    "requirements-repository": {
      "description": "SDLC-PREV-004 Requirements Repository, as enforced here: version-controlled specs that gates/spec-check.mjs reads.",
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "requirement-url": {
                  "const": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-004-requirements/requirement/versions/1.0.0",
                  "description": "The catalog's control requirement document on CALM Hub; the CLI validates the config against it"
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "description": "Repo path of the approved requirements repository"
                    },
                    "audit-trail": {
                      "enum": [
                        "version-control",
                        "ticket-history",
                        "immutable"
                      ]
                    }
                  },
                  "required": [
                    "repository",
                    "audit-trail"
                  ]
                }
              },
              "required": [
                "requirement-url",
                "config"
              ]
            }
          ]
        }
      },
      "required": [
        "requirements"
      ]
    },
    "deployment-gating": {
      "description": "SDLC-PREV-012 Deployment Gating, as enforced here: the gates gates/run-all.mjs must see pass before a change is admissible.",
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "requirement-url": {
                  "const": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-012-deployment-gating/requirement/versions/1.0.0",
                  "description": "The catalog's control requirement document on CALM Hub; the CLI validates the config against it"
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "blocking-gates": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "uniqueItems": true,
                      "description": "Every named gate must pass before a change is admissible; gates/run-all.mjs runs them"
                    }
                  },
                  "required": [
                    "blocking-gates"
                  ]
                }
              },
              "required": [
                "requirement-url",
                "config"
              ]
            }
          ]
        }
      },
      "required": [
        "requirements"
      ]
    },
    "test-evidence-retention": {
      "description": "SDLC-PREV-014 Test Evidence Retention, as enforced here: what gates/evidence.mjs binds each evidence bundle to.",
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "requirement-url": {
                  "const": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-014-test-evidence/requirement/versions/1.0.0",
                  "description": "The catalog's control requirement document on CALM Hub; the CLI validates the config against it"
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "bound-to": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "description": "What each evidence bundle is bound to"
                    },
                    "format": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "bound-to"
                  ]
                }
              },
              "required": [
                "requirement-url",
                "config"
              ]
            }
          ]
        }
      },
      "required": [
        "requirements"
      ]
    },
    "service-dependency-control": {
      "description": "SDLC-PREV-017 Service Dependency Control, as enforced here: the only nodes that may connect to the node carrying the control, which gates/drift-check.mjs compares with the code.",
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "requirement-url": {
                  "const": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-017-service-dependency-control/requirement/versions/1.0.0",
                  "description": "The catalog's control requirement document on CALM Hub; the CLI validates the config against it"
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "allowed-sources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "uniqueItems": true,
                      "description": "CALM node ids permitted to connect to the node that carries this control"
                    }
                  },
                  "required": [
                    "allowed-sources"
                  ]
                }
              },
              "required": [
                "requirement-url",
                "config"
              ]
            }
          ]
        }
      },
      "required": [
        "requirements"
      ]
    }
  }
}
