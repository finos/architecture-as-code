{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://calm.finos.org/standards/control-evaluation/1.0/control-evaluation.decorator.standard.json",
    "title": "CALM Control Evaluation Decorator Standard",
    "description": "Records the result of evaluating one control from a CALM architecture, such as a policy engine checking a change before it merges. Pins the result, and the reasons for it, onto the architecture elements it concerns. Extends the base CALM decorator.",
    "allOf": [
        {
            "$ref": "https://calm.finos.org/release/1.3/meta/decorators.json#/defs/decorator"
        },
        {
            "type": "object",
            "properties": {
                "type": {
                    "const": "control-evaluation",
                    "description": "Must be 'control-evaluation' for control evaluation decorators"
                },
                "target-type": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "architecture"
                        ]
                    },
                    "description": "Control evaluation decorators target the architecture whose controls were evaluated."
                },
                "data": {
                    "type": "object",
                    "properties": {
                        "control": {
                            "type": "object",
                            "description": "The control that was evaluated, as it appears in the targeted architecture",
                            "properties": {
                                "unique-id": {
                                    "type": "string",
                                    "description": "The control's key in the architecture's controls map",
                                    "minLength": 1
                                },
                                "control-id": {
                                    "type": "string",
                                    "description": "The control's identifier in an external catalog, such as SDLC-PREV-001",
                                    "minLength": 1
                                },
                                "requirement-url": {
                                    "type": "string",
                                    "format": "uri",
                                    "description": "Fully qualified URL of the control requirement the evaluated configuration conforms to, such as its document on CALM Hub"
                                },
                                "attached-to": {
                                    "type": "string",
                                    "description": "unique-id of the architecture element that carries the control",
                                    "minLength": 1
                                }
                            },
                            "required": [
                                "unique-id",
                                "requirement-url"
                            ],
                            "additionalProperties": true
                        },
                        "status": {
                            "type": "string",
                            "enum": [
                                "met",
                                "not-met",
                                "not-applicable"
                            ],
                            "description": "met: every check in scope passed. not-met: a check failed, or the engine could not do it. not-applicable: nothing was in scope."
                        },
                        "evaluated-at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "ISO 8601 timestamp of the evaluation"
                        },
                        "change": {
                            "type": "object",
                            "description": "The change evaluated, when the evaluation was of a proposed change",
                            "properties": {
                                "commit": {
                                    "type": "string",
                                    "description": "Commit identifier of the change",
                                    "minLength": 1
                                },
                                "diff-sha256": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}$",
                                    "description": "SHA-256 of the exact diff evaluated, in lowercase hex"
                                },
                                "spec": {
                                    "type": "string",
                                    "description": "Identifier of the requirement or specification the change implements",
                                    "minLength": 1
                                }
                            },
                            "required": [
                                "commit"
                            ],
                            "additionalProperties": true
                        },
                        "findings": {
                            "type": "array",
                            "description": "Why the control was not met: one entry per failed check. Only for a not-met evaluation",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "subject": {
                                        "type": "string",
                                        "description": "What the check was about: an architecture element unique-id, or another identifier such as a connection found in code",
                                        "minLength": 1
                                    },
                                    "check": {
                                        "type": "string",
                                        "description": "Name of the check that failed",
                                        "minLength": 1
                                    },
                                    "description": {
                                        "type": "string",
                                        "description": "What the check requires, in plain words",
                                        "minLength": 1
                                    },
                                    "expression": {
                                        "type": "string",
                                        "description": "The check as the engine expressed it",
                                        "minLength": 1
                                    },
                                    "cause": {
                                        "type": "string",
                                        "description": "Why the check failed, such as absent or value",
                                        "minLength": 1
                                    }
                                },
                                "required": [
                                    "subject",
                                    "description"
                                ],
                                "additionalProperties": true
                            }
                        },
                        "actors": {
                            "type": "object",
                            "description": "Identities involved in the change, such as author, reviewer and approver",
                            "additionalProperties": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "engine": {
                            "type": "object",
                            "description": "What evaluated the control",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "version": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "policy-sha256": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}$",
                                    "description": "SHA-256 of the policy or module evaluated, in lowercase hex"
                                }
                            },
                            "required": [
                                "name"
                            ],
                            "additionalProperties": true
                        },
                        "report-sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$",
                            "description": "SHA-256 of the engine's full report, kept as evidence, in lowercase hex"
                        },
                        "report-uri": {
                            "type": "string",
                            "format": "uri-reference",
                            "description": "Where the engine's full report is kept",
                            "minLength": 1
                        }
                    },
                    "required": [
                        "control",
                        "status",
                        "evaluated-at"
                    ],
                    "if": {
                        "properties": {
                            "status": {
                                "const": "not-met"
                            }
                        },
                        "required": [
                            "status"
                        ]
                    },
                    "then": {
                        "properties": {
                            "findings": {
                                "minItems": 1
                            }
                        },
                        "required": [
                            "findings"
                        ]
                    },
                    "else": {
                        "properties": {
                            "findings": false
                        }
                    },
                    "additionalProperties": true
                }
            },
            "required": [
                "type",
                "target-type",
                "data"
            ]
        }
    ]
}
