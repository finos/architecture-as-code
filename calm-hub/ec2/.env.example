# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# docker compose automatically loads .env from the current directory.

# Image to run. Defaults to the read-only-native build of main, which changes on
# every merge. latest-read-only-native changes only on a CALM Hub release.
# To pin a version (e.g. to roll back), point this at a tag that never changes,
# such as a release or a sha tag:
#   CALM_HUB_IMAGE=finos/calm-hub:0.8.0-read-only-native
#   CALM_HUB_IMAGE=finos/calm-hub:sha-1a2b3c4-read-only-native
# Watchtower has nothing new to pull for a pinned tag, so it stops
# auto-updating until you set this back to main-read-only-native.
CALM_HUB_IMAGE=finos/calm-hub:main-read-only-native

# Public URL of this Hub. The Hub uses it as the base of the $id of each
# name-based document that it serves. Change it only if the Hub has a
# different public URL.
CALM_HUB_BASE_URL=https://hub.calm.finos.org

# How often Watchtower polls Docker Hub for a newer image, in seconds.
WATCHTOWER_POLL_INTERVAL=120
