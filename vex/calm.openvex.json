          "subcomponents": [
            {
              "@id": "pkg:cargo/glib@0.18.5"
            }
          ]
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "glib 0.18 is pinned by the Tauri GTK stack used by the CALM Studio desktop app. CALM Studio does not call the unsound glib::VariantStrIter iterator implementations. The fix (glib 0.20) needs a Tauri release that moves to gtk-rs 0.20."
    },
