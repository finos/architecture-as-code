{
    "title": "Shop",
    "nodes": [
        { "unique-id": "buyer", "node-type": "actor", "name": "Buyer", "description": "Buys things" },
        { "unique-id": "shop", "node-type": "system", "name": "Shop System", "description": "Sells things" },
        { "unique-id": "web", "node-type": "webclient", "name": "Web", "description": "Shop front" },
        { "unique-id": "orders", "node-type": "service", "name": "Orders", "description": "Takes orders" },
        { "unique-id": "orders-db", "node-type": "database", "name": "Orders DB", "description": "Stores orders" },
        { "unique-id": "payments", "node-type": "system", "name": "Payments", "description": "Takes payment" }
    ],
    "relationships": [
        { "unique-id": "shop-composed-of", "relationship-type": { "composed-of": { "container": "shop", "nodes": ["web", "orders", "orders-db"] } } },
