        { "unique-id": "orders-db", "description": "Stores orders", "protocol": "JDBC", "relationship-type": { "connects": { "source": { "node": "orders" }, "destination": { "node": "orders-db" } } } },
        { "unique-id": "orders-payments", "description": "Takes payment", "protocol": "HTTPS", "relationship-type": { "connects": { "source": { "node": "orders" }, "destination": { "node": "payments" } } } }
    ]
