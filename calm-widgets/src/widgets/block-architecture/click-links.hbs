{{!-- Handle individual node (VMLeafNode) when called from looseNodes --}}
{{!-- linkId is the CALM unique-id, also for copies of a node drawn in several containers --}}
{{#if id}}
    {{!-- Generate click for the node itself --}}
    {{#if (lookup linkMap (linkId this))}}
click {{{mermaidId id}}} "{{lookup linkMap (linkId this)}}" "Jump to {{label}}"
    {{else if linkPrefix}}
click {{{mermaidId id}}} "{{linkPrefix}}{{linkId this}}" "Jump to {{label}}"
    {{/if}}
    {{!-- Generate clicks for interfaces --}}
    {{#each interfaces}}
        {{#if (lookup ../linkMap (linkId this))}}
click {{{mermaidId id}}} "{{lookup ../linkMap (linkId this)}}" "Jump to {{label}}"
        {{else if ../linkPrefix}}
click {{{mermaidId id}}} "{{../linkPrefix}}{{linkId this}}" "Jump to {{label}}"
        {{/if}}
    {{/each}}
{{/if}}

{{!-- Handle container with nodes array --}}
{{#each nodes}}
    {{#if (lookup ../linkMap (linkId this))}}
click {{{mermaidId id}}} "{{lookup ../linkMap (linkId this)}}" "Jump to {{label}}"
    {{else if ../linkPrefix}}
click {{{mermaidId id}}} "{{../linkPrefix}}{{linkId this}}" "Jump to {{label}}"
    {{/if}}
    {{#each interfaces}}
        {{#if (lookup ../../linkMap (linkId this))}}
click {{{mermaidId id}}} "{{lookup ../../linkMap (linkId this)}}" "Jump to {{label}}"
        {{else if ../../linkPrefix}}
click {{{mermaidId id}}} "{{../../linkPrefix}}{{linkId this}}" "Jump to {{label}}"
        {{/if}}
    {{/each}}
{{/each}}

{{!-- Handle nested containers --}}
{{#each containers}}
    {{> click-links.hbs this linkPrefix=../linkPrefix linkMap=../linkMap}}
{{/each}}
