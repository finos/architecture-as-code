{{!-- Only emit a subgraph if it has content --}}
{{#if (or (gt (length nodes) 0) (gt (length containers) 0))}}
    subgraph {{{mermaidId id}}}["{{{mermaidQuotedText label}}}"]
    direction TB
    {{#each nodes}}
    {{#if @root.renderNodeTypeShapes}}
        {{> typed-node.hbs}}
    {{else}}
        {{{mermaidId id}}}["{{{mermaidQuotedText label}}}"]:::node
    {{/if}}
        {{#each interfaces}}
            {{{mermaidId id}}}["{{{mermaidQuotedText label}}}"]:::iface
        {{/each}}
    {{/each}}
    {{#each containers}}
        {{> container.hbs}}
    {{/each}}
    end
    class {{{mermaidId id}}} boundary
{{/if}}