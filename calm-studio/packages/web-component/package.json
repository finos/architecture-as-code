{
  "name": "@calmstudio/diagram",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/calm-diagram.es.js",
  "module": "./dist/calm-diagram.es.js",
  "exports": {
    ".": {
      "import": "./dist/calm-diagram.es.js",
      "require": "./dist/calm-diagram.iife.js"
    },
    "./render": {
      "import": "./dist/render.es.js",
      "require": "./dist/render.cjs"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.iife.ts && vite build --config vite.config.render-es.ts && vite build --config vite.config.render-cjs.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calmstudio/calm-core": "*",
    "@calmstudio/extensions": "*",
    "elkjs": "^0.11.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.55.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.0"
  }
}
